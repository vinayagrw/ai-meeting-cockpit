# Secrets and local machine overrides only.
# Main runtime settings live in meeting-recorder.config.json.
OPENAI_API_KEY=
MEETING_COMPANION_SUMMARY_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: full path to ffmpeg.exe if it is not on PATH
MEETING_COMPANION_FFMPEG=
# Optional: full path to python.exe if you do not use .venv
MEETING_RECORDER_PYTHON=
